# MongoDB
MONGO_URI=mongodb://localhost:27017/talentx

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Super Admin seed
SUPER_ADMIN_NAME=TalentX Super Admin
SUPER_ADMIN_EMAIL=super.admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Rate Limiting
GENERAL_RATE_LIMIT_MAX=2000

# Scheduler
ENABLE_SCHEDULER=true

# Razorpay (for payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Service — driver-based adapter
# EMAIL_DRIVER: "mailpit" (local dev), "brevo" (production), or leave empty to log-only
EMAIL_DRIVER=mailpit
EMAIL_FROM_NAME=TalentX
EMAIL_FROM_EMAIL=no-reply@talentx.com
EMAIL_TIMEOUT_MS=8000

# Mailpit (local development) — requires Mailpit running via Docker
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

# Brevo REST API (production) — get free API key at https://app.brevo.com
# BREVO_API_KEY=your_brevo_api_key

# AI Services (optional)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Geoapify (optional) — used for location autosuggest in frontend
# If you use frontend dev server, set VITE_GEOAPIFY_API_KEY in frontend/.env
GEOAPIFY_API_KEY=your_geoapify_api_key

# Logo Dev API (optional)
LOGO_DEV_API_KEY=your_logo_dev_api_key

# Backend Public URL (for interview room)
BACKEND_PUBLIC_URL=http://localhost:5000

# Environment
NODE_ENV=development
PORT=5000
